# Budget Escape Travel Planner — environment variables
#
# Copy this file to `.env` and fill in the values. NEVER commit real secrets.
# All variables here are optional for the current static MVP build; they become
# required as live data providers are integrated in later issues.
#
# Copy and rename in place:
#   cp .env.example .env

# Public web origin used when building absolute URLs (OG images, canonical links).
# Example: https://budget-escape-travel-planner.vercel.app
VITE_PUBLIC_ORIGIN=

# --- Data / pricing providers (unused in the static MVP; reserved for later) ---
# Amadeus Self-Service API key for flight price estimates.
# https://developers.amadeus.com/
VITE_AMADEUS_API_KEY=
# GeoNames username for destination metadata (cities, coordinates, nearby POIs).
# http://www.geonames.org/export/web-services.html
VITE_GEONAMES_USERNAME=

# --- Image provenance ---
# Image source name shown in result cards. Not a secret; used for attribution.
VITE_IMAGE_SOURCE=Wikimedia Commons
